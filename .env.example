# ==========================================
# Telegram Business Assistant Bot Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Owner Telegram User ID (numeric, from @userinfobot)
ADMIN_TELEGRAM_ID=1234567890

# Database Connection URL (PostgreSQL async or SQLite for dev)
# PostgreSQL example: postgresql+asyncpg://postgres:postgres@localhost:5432/telegram_bot_db
# Docker compose example: postgresql+asyncpg://postgres:postgres@postgres:5432/telegram_bot_db
# Local SQLite fallback: sqlite+aiosqlite:///./bot_database.db
DATABASE_URL=sqlite+aiosqlite:///./bot_database.db

# Redis URL (Optional for cache/FSM storage, defaults to memory if empty)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# AI Assistant (OpenAI API Key for natural language assistant & function calling)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Webhook or Polling mode
# Set USE_WEBHOOK=true for production webhook mode with FastAPI
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=your-secure-webhook-secret-token
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Business Operating System Defaults
TIMEZONE=Asia/Phnom_Penh
CURRENCY_SYMBOL=$
LOW_STOCK_THRESHOLD=10
MORNING_REMINDER_TIME=08:00
DAILY_REPORT_REMINDER_TIME=18:00
RATE_LIMIT_PER_SECOND=2.0
LOG_LEVEL=INFO
